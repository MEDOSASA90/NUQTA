{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/**"
    }
  }
}
