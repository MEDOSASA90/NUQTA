# ── Backend ─────────────────────────────────────────────────────
APP_ID=nuqta              # Optional application identifier
APP_SECRET=               # Required: long random value used for signing sessions

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Optional legacy Kimi OAuth URL
VITE_APP_ID=              # Optional legacy OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Optional legacy Kimi OAuth server URL
KIMI_OPEN_URL=            # Optional legacy Kimi Open Platform URL

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
